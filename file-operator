import os
from datetime import datetime

FILE_NAME = "journal.txt"


def add_entry():
    title = input("Enter journal title: ")
    content = input("Write your journal entry: ")

    date = datetime.now().strftime("%Y-%m-%d %H:%M:%S")

    with open(FILE_NAME, "a") as file:
        file.write(f"DATE: {date}\n")
        file.write(f"TITLE: {title}\n")
        file.write(f"ENTRY: {content}\n")
        file.write("-" * 50 + "\n")

    print("Journal entry added successfully!")


def view_entries():
    if not os.path.exists(FILE_NAME):
        print("No journal entries found.")
        return

    with open(FILE_NAME, "r") as file:
        data = file.read()

    if data.strip() == "":
        print("No journal entries found.")
    else:
        print("\n===== MY JOURNAL =====")
        print(data)


def search_entry():
    keyword = input("Enter keyword to search: ").lower()

    if not os.path.exists(FILE_NAME):
        print("No journal entries found.")
        return

    with open(FILE_NAME, "r") as file:
        entries = file.read().split("-" * 50)

    found = False

    for entry in entries:
        if keyword in entry.lower():
            print("\n" + entry)
            found = True

    if not found:
        print("No matching entry found.")


def delete_entries():
    if os.path.exists(FILE_NAME):
        os.remove(FILE_NAME)
        print("All journal entries deleted.")
    else:
        print("No journal entries found.")


def menu():
    while True:
        print("\n===== PERSONAL JOURNAL MANAGER =====")
        print("1. Add Journal Entry")
        print("2. View All Entries")
        print("3. Search Entry")
        print("4. Delete All Entries")
        print("5. Exit")

        choice = input("Enter your choice: ")

        if choice == "1":
            add_entry()

        elif choice == "2":
            view_entries()

        elif choice == "3":
            search_entry()

        elif choice == "4":
            delete_entries()

        elif choice == "5":
            print("Thank you for using Personal Journal Manager!")
            break

        else:
            print("Invalid choice. Please try again.")


menu()